# Copy to .env (which is git-ignored) and adjust. No passwords belong in the code.
# Postgres.app on a Mac: your Mac user name, no password.
DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/iris
# Separate database for the automated tests - its iris_staging schema is wiped by the tests!
TEST_DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/iris_test
# Optional: contact address added to the User-Agent for --live downloads
HARVESTER_CONTACT=your.email@example.com
